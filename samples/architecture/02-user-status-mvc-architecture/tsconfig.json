{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/app.ts",
    "src/UserModel.ts",
    "src/UserStatusView.ts",
    "src/UserStatusController.ts",
    "src/UserStatus.spec.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
