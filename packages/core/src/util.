import { describe, it, expect } from 'vitest';
import { Sanitizer } from '../src/util/Sanitizer.js';

describe('Sanitizer — XSS prevention', () => {
  it('removes script tags', () => {
    const result = Sanitizer.sanitize('<p>Hello</p><script>alert(1)</script>');
    expect(result).not.toContain('<script');
    expect(result).not.toContain('alert');
    expect(result).toContain('<p>Hello</p>');
  });

  it('removes event handler attributes', () => {
    const result = Sanitizer.sanitize('<div onclick="alert(1)">Click</div>');
    expect(result).not.toContain('onclick');
    expect(result).toContain('Click');
  });

  it('removes onerror on img', () => {
    const result = Sanitizer.sanitize('<img src="x" onerror="alert(1)">');
    expect(result).not.toContain('onerror');
  });

  it('removes javascript: URLs from href', () => {
    const result = Sanitizer.sanitize('<a href="javascript:alert(1)">Link</a>');
    expect(result).not.toContain('javascript:');
  });

  it('removes javascript: URLs from src', () => {
    const result = Sanitizer.sanitize('<img src="javascript:alert(1)">');
    expect(result).not.toContain('javascript:');
  });

  it('preserves safe HTML', () => {
    const html = '<p>Hello <strong>world</strong></p>';
    expect(Sanitizer.sanitize(html)).toBe(html);
  });

  it('preserves safe attributes', () => {
    const html = '<a href="https://example.com" class="link" title="Go">Link</a>';
    const result = Sanitizer.sanitize(html);
    expect(result).toContain('href="https://example.com"');
    expect(result).toContain('class="link"');
  });

  it('preserves ARIA attributes', () => {
    const html = '<div role="button" aria-label="Save" aria-expanded="true">Save</div>';
    const result = Sanitizer.sanitize(html);
    expect(result).toContain('role="button"');
    expect(result).toContain('aria-label="Save"');
  });

  it('strips iframe tags', () => {
    const result = Sanitizer.sanitize('<iframe src="evil.com"></iframe>');
    expect(result).not.toContain('<iframe');
  });

  it('strips form tags', () => {
    const result = Sanitizer.sanitize('<form action="evil.com"><input></form>');
    expect(result).not.toContain('<form');
  });

  it('strips object/embed tags', () => {
    const result = Sanitizer.sanitize('<object data="evil.swf"></object><embed src="x">');
    expect(result).not.toContain('<object');
    expect(result).not.toContain('<embed');
  });

  it('handles nested dangerous content', () => {
    const html = '<div><p><script>alert(1)</script></p></div>';
    const result = Sanitizer.sanitize(html);
    expect(result).not.toContain('<script');
    expect(result).toContain('<div>');
    expect(result).toContain('<p>');
  });

  it('handles empty input', () => {
    expect(Sanitizer.sanitize('')).toBe('');
    expect(Sanitizer.sanitize(null as any)).toBe('');
  });

  it('handles plain text (no tags)', () => {
    expect(Sanitizer.sanitize('Hello world')).toBe('Hello world');
  });
});

describe('Sanitizer.escapeHtml', () => {
  it('escapes HTML special characters', () => {
    expect(Sanitizer.escapeHtml('<script>')).toBe('&lt;script&gt;');
    expect(Sanitizer.escapeHtml('"quotes"')).toBe('&quot;quotes&quot;');
    expect(Sanitizer.escapeHtml("it's")).toBe("it&#39;s");
    expect(Sanitizer.escapeHtml('a & b')).toBe('a &amp; b');
  });
});

describe('Sanitizer.isSafe', () => {
  it('detects script tags as unsafe', () => {
    expect(Sanitizer.isSafe('<script>alert(1)</script>')).toBe(false);
  });

  it('detects event handlers as unsafe', () => {
    expect(Sanitizer.isSafe('<div onclick="x">')).toBe(false);
  });

  it('detects javascript: URLs as unsafe', () => {
    expect(Sanitizer.isSafe('<a href="javascript:void(0)">')).toBe(false);
  });

  it('reports safe HTML as safe', () => {
    expect(Sanitizer.isSafe('<p>Hello <b>world</b></p>')).toBe(true);
  });
});
