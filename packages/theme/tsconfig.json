{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@framesquared/core": [
        "../core/src/index.ts"
      ],
      "@framesquared/component": [
        "../component/src/index.ts"
      ]
    },
