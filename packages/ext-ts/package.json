{
  "name": "framesquared",
  "private": true,
  "version": "0.1.0",
  "description": "Modern TypeScript reimplementation of ExtJS — umbrella package",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core.js",
      "types": "./dist/core.d.ts"
    },
    "./data": {
      "import": "./dist/data.js",
      "types": "./dist/data.d.ts"
    },
    "./component": {
      "import": "./dist/component.js",
      "types": "./dist/component.d.ts"
    },
    "./layout": {
      "import": "./dist/layout.js",
      "types": "./dist/layout.d.ts"
    },
    "./ui": {
      "import": "./dist/ui.js",
      "types": "./dist/ui.d.ts"
    },
    "./form": {
      "import": "./dist/form.js",
      "types": "./dist/form.d.ts"
    },
    "./grid": {
      "import": "./dist/grid.js",
      "types": "./dist/grid.d.ts"
    },
    "./dd": {
      "import": "./dist/dd.js",
      "types": "./dist/dd.d.ts"
    },
    "./fx": {
      "import": "./dist/fx.js",
      "types": "./dist/fx.d.ts"
    },
    "./app": {
      "import": "./dist/app.js",
      "types": "./dist/app.d.ts"
    },
    "./theme": {
      "import": "./dist/theme.js",
      "types": "./dist/theme.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@framesquared/core": "workspace:*",
    "@framesquared/data": "workspace:*",
    "@framesquared/component": "workspace:*",
    "@framesquared/layout": "workspace:*",
    "@framesquared/ui": "workspace:*",
    "@framesquared/form": "workspace:*",
    "@framesquared/grid": "workspace:*",
    "@framesquared/dd": "workspace:*",
    "@framesquared/fx": "workspace:*",
    "@framesquared/app": "workspace:*",
    "@framesquared/theme": "workspace:*"
  }
}
