{
  "$schema": "https://typedoc.org/schema.json",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/core",
    "packages/data",
    "packages/component",
    "packages/layout",
    "packages/ui",
    "packages/form",
    "packages/grid",
    "packages/dd",
    "packages/fx",
    "packages/app",
    "packages/theme"
  ],
  "out": "docs/api",
  "name": "framesquared API Documentation",
  "readme": "README.md",
  "includeVersion": true,
  "categorizeByGroup": true,
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "visibilityFilters": {
    "protected": true,
    "private": false
  },
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": true,
  "excludeExternals": true
}
